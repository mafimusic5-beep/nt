server {
    listen 80;
    server_name vpn.example.com;

    client_max_body_size 2m;

    # Privacy by default: the public edge keeps no per-request IP/URI history.
    # Health is monitored explicitly, so client-facing nginx diagnostics are
    # discarded rather than becoming an incidental activity log.
    access_log off;
    error_log /dev/null crit;

    location /healthz {
        proxy_pass http://127.0.0.1:9330/api/v1/health;
        proxy_set_header Host $host;
    }

    location /readyz {
        proxy_pass http://127.0.0.1:9330/api/v1/ready;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://127.0.0.1:9330;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # The backend may use the peer address transiently for anti-abuse. It
        # must not persist or log this value as user history.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
