EMERY_GATE_BIND_HOST=0.0.0.0
EMERY_GATE_BIND_PORT=24443
EMERY_GATE_NODE_ID=1
EMERY_GATE_SERVER_NAME=gate.example.com
EMERY_GATE_SPKI_SHA256=REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS
EMERY_GATE_TLS_CERT_FILE=/etc/letsencrypt/live/gate.example.com/fullchain.pem
EMERY_GATE_TLS_KEY_FILE=/etc/letsencrypt/live/gate.example.com/privkey.pem
EMERY_GATE_AUTHORIZE_URL=https://activation.example.com/internal/device-gate/authorize
EMERY_GATE_AUTHORIZE_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
EMERY_GATE_CONTROL_TIMEOUT_SECONDS=10
EMERY_GATE_CONNECT_TIMEOUT_SECONDS=5
EMERY_GATE_MAX_CONNECTIONS=2048
EMERY_GATE_LOG_LEVEL=INFO
