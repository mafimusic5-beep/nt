APP_ENV=production
LOG_LEVEL=INFO
DB_URL=sqlite:///./data/app.db
BACKEND_BASE_URL=https://backend.example.com
INTERNAL_API_KEY=REPLACE_WITH_RANDOM_SECRET
ADMIN_API_KEY=REPLACE_WITH_RANDOM_SECRET

POOL_NODE_CAPACITY_DEVICES=20
POOL_FAMILY_HEADROOM_DEVICES=5
POOL_NODE_BANDWIDTH_MBPS=600
POOL_PER_DEVICE_SPEED_LIMIT_MBPS=30
POOL_ACCOUNTING_BRIDGE_ENABLED=false
UNIQUE_DEVICE_CREDENTIALS_ENABLED=false
PER_DEVICE_RATE_LIMIT_ENFORCED=false
SMTP_ABUSE_PROTECTION_ENABLED=false
DEVICE_BOUND_GATE_ENABLED=false
DEVICE_GATE_CLIENT_LOOPBACK_PORT=17890
DEVICE_GATE_SERVICE_NAME=emery-device-gate
DEVICE_GATE_API_KEY=REPLACE_WITH_SEPARATE_GATE_SECRET
POOL_BRIDGE_API_KEY=REPLACE_WITH_SHARED_RANDOM_SECRET
POOL_ASSIGNMENT_PREPARE_TTL_SECONDS=300
POOL_ASSIGNMENT_MAINTENANCE_INTERVAL_SECONDS=60
MIN_SUPPORTED_APP_VERSION_CODE=718

XRAY_CONFIG_PATH=/usr/local/etc/xray/config.json
XRAY_CLIENT_PORT_START=20000
XRAY_CLIENT_PORT_END=20199
XRAY_CREDENTIAL_SCRIPT=
XRAY_CREDENTIAL_TIMEOUT_SECONDS=90

AUTO_PROVISION_ENABLED=false
AUTO_PROVISION_PROVIDER=unconfigured
NODE_PROVISION_SCRIPT=
NODE_PROVISION_SCRIPT_TIMEOUT_SECONDS=900
AUTO_PROVISION_SERVER_MONTHLY_COST_EUR=0
AUTO_PROVISION_MAX_SERVERS_PER_HOUR=1
AUTO_PROVISION_MAX_SERVERS_PER_DAY=2
AUTO_PROVISION_MONTHLY_BUDGET_EUR=0
AUTO_PROVISION_RETRY_SECONDS=300

# Already purchased VPS: no provider API token, no automatic orders.
# Read docs/MANUAL_VPS_SETUP.md before enabling on the controller.
MANUAL_VPS_SETUP_ENABLED=false
MANUAL_VPS_PROFILE_PATH=/etc/emery/manual-vps/profile.json
MANUAL_VPS_GATE_AUTHORIZE_KEY=

# IONOS CLOUD / Data Center Designer, NOT retail VPS+ / Cloud Panel v1.
# Both purchase switches stay OFF until account, DNS, control API and budget
# have been configured and reviewed. Never put these credentials in the APK.
IONOS_CLOUD_APPLY_ENABLED=false
IONOS_CLOUD_TOKEN=
IONOS_CLOUD_CONTRACT_NUMBER=
# Explicit per-region image and hardware; no automatic paid plan selection.
IONOS_CLOUD_REGION_PROFILES_JSON={}
IONOS_CLOUD_MANAGEMENT_IPV4=
IONOS_CLOUD_DNS_ZONE_ID=
IONOS_CLOUD_DOMAIN_SUFFIX=
# Empty means use IONOS_CLOUD_TOKEN for Cloud DNS as well.
IONOS_CLOUD_DNS_TOKEN=
IONOS_CLOUD_GATE_AUTHORIZE_URL=
IONOS_CLOUD_GATE_AUTHORIZE_KEY=
IONOS_CLOUD_ACME_EMAIL=
IONOS_CLOUD_ACME_TERMS_ACCEPTED=false
IONOS_CLOUD_XRAY_VERSION=
IONOS_CLOUD_XRAY_SHA256=
IONOS_CLOUD_REALITY_SERVER_NAME=apple.com
IONOS_CLOUD_PROBE_URL=https://example.com/
IONOS_CLOUD_BOOTSTRAP_TIMEOUT_SECONDS=7200

AUTO_RENEWAL_ACTIONS_ENABLED=false
NODE_RENEWAL_SCRIPT=
RENEWAL_PLANNING_HORIZON_DAYS=14
RENEWAL_PLANNING_INTERVAL_SECONDS=21600

RECOVERY_PROBE_INTERVAL_SECONDS=15
RECOVERY_FAILURE_THRESHOLD=3
RECOVERY_SSH_USER=root
RECOVERY_SSH_PRIVATE_KEY_PATH=/etc/emery/recovery-ssh/id_ed25519
RECOVERY_SSH_KNOWN_HOSTS_PATH=/etc/emery/ssh/known_hosts
RECOVERY_ALLOW_UNKNOWN_HOST_KEYS=false
RECOVERY_PROVIDER_REBOOT_SCRIPT=
